
# examples https://github.com/search?q=path%3Aghostty%2Fconfig&type=code
# Tokyo Night palette
# Ghostty ships this theme; the terminal selects it directly.
theme = tokyonight

# Font get available with `ghostty +list-fonts`
#font-family = "Symbols Nerd Font Mono"
#font-family = "MesloLGSDZ Nerd Font Mono"
font-family = "MesloLGS Nerd Font Mono"
#font-family = "JetBrainsMono Nerd Font Mono"
font-size = 12
font-thicken = true


# Keybindings
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = performable:ctrl+c=copy_to_clipboard

# Mouse
mouse-hide-while-typing = true
