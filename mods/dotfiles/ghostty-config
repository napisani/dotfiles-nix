
# Mirrors kitty.conf. OmniWM's quake terminal embeds Ghostty and reads this file,
# so it stays linked even though the Ghostty app is not installed.

# Kanagawa Dragon vivid terminal palette.
palette = 0=#1f1f28
palette = 1=#ff5d62
palette = 2=#98bb6c
palette = 3=#ff9e3b
palette = 4=#7fb4ca
palette = 5=#c4a7e7
palette = 6=#a3d4d5
palette = 7=#dcd7ba
palette = 8=#a6a69c
palette = 9=#ff5d62
palette = 10=#98bb6c
palette = 11=#ff9e3b
palette = 12=#7fb4ca
palette = 13=#c4a7e7
palette = 14=#a3d4d5
palette = 15=#dcd7ba
background = #1f1f28
foreground = #dcd7ba
cursor-color = #dcd7ba
cursor-text = #1f1f28
selection-background = #2d4f67
selection-foreground = #dcd7ba

# Font get available with `ghostty +list-fonts`
font-family = "MesloLGSDZ Nerd Font Mono"
font-size = 12
font-thicken = true

# Defaults carried over from the previous Alacritty setup.
cursor-style = block
cursor-style-blink = false
window-padding-x = 0
window-padding-y = 0
window-save-state = never
macos-titlebar-style = native
confirm-close-surface = false
quit-after-last-window-closed = true
# Shell integration would inject into the hand-managed bash setup.
shell-integration = none

# Clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard

# tmux requests modifyOtherKeys. Explicit CSI-u inputs let tmux encode modified
# keys for each pane's mode, as in kitty.conf.
keybind = ctrl+slash=text:\x1f
keybind = ctrl+q=text:\x1b[81;5u
keybind = ctrl+shift+p=text:\x1b[80;6u
keybind = ctrl+shift+r=text:\x1b[82;6u
keybind = ctrl+shift+e=text:\x1b[69;6u
keybind = ctrl+shift+f=text:\x1b[70;6u
keybind = ctrl+shift+t=text:\x1b[84;6u
keybind = ctrl+shift+h=text:\x1b[72;6u

# Specialty TUI chords, CSI-u encoded: ESC [ <keycode> ; <mods> u
# where mods: 2=Shift, 3=Alt, 5=Ctrl, 6=Ctrl+Shift.
keybind = shift+enter=text:\x1b[13;2u
keybind = ctrl+enter=text:\x1b[13;5u
keybind = ctrl+shift+enter=text:\x1b[13;6u
keybind = alt+enter=text:\x1b[13;3u
keybind = alt+backspace=text:\x1b[127;3u
keybind = ctrl+shift+backspace=text:\x1b[127;6u
