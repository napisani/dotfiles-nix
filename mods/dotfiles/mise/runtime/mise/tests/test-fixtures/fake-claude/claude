#!/usr/bin/env node

const fs = require("node:fs");
const path = require("node:path");

const args = process.argv.slice(2);
fs.appendFileSync(process.env.CALL_LOG, args.join(" ") + "\n");

const stateFile = process.env.CLAUDE_INSTALL_STATE;
const readInstalled = () => {
  if (!stateFile || !fs.existsSync(stateFile)) return [];
  return JSON.parse(fs.readFileSync(stateFile, "utf8"));
};
const writeInstalled = (entries) => {
  fs.mkdirSync(path.dirname(stateFile), { recursive: true });
  fs.writeFileSync(stateFile, JSON.stringify(entries));
};
const upgradedFile = stateFile && path.join(path.dirname(stateFile), "upgraded.json");
const readUpgraded = () =>
  upgradedFile && fs.existsSync(upgradedFile)
    ? JSON.parse(fs.readFileSync(upgradedFile, "utf8"))
    : [];
const artifactPath = (id) => path.join(path.dirname(stateFile), "artifacts", encodeURIComponent(id));

if (args[0] !== "plugin") process.exit(2);
const marketplaceFile = process.env.CLAUDE_MARKETPLACE_STATE;
const marketplaces = marketplaceFile
  ? (fs.existsSync(marketplaceFile) ? JSON.parse(fs.readFileSync(marketplaceFile, "utf8")) : [])
  : [{ name: "m" }, { name: "marketplace" }, { name: "branched" }, { name: "manual" }];
if (args[1] === "marketplace") {
  if (args[2] === "list") {
    process.stdout.write(process.env.CLAUDE_MARKETPLACE_LIST_INVALID || JSON.stringify(marketplaces));
  } else if (args[2] === "add" && marketplaceFile) {
    if (process.env.CLAUDE_FAIL_MARKETPLACE_ADD) process.exit(1);
    const settings = JSON.parse(fs.readFileSync(path.join(process.env.HOME, ".claude/settings.json"), "utf8"));
    const name = Object.keys(settings.extraKnownMarketplaces).find((name) =>
      settings.extraKnownMarketplaces[name].source.repo === args[3]
    );
    if (!name || args.slice(4).join(" ") !== "--scope user") process.exit(2);
    fs.writeFileSync(marketplaceFile, JSON.stringify([...marketplaces, { name }]));
  } else if (args[2] === "update" && !marketplaces.some((row) => row.name === args[3])) {
    process.exit(1);
  }
  process.exit(0);
}

if (args[1] === "list" && args.includes("--json")) {
  if (process.env.CLAUDE_LIST_INVALID === "schema") {
    process.stdout.write(JSON.stringify([{ id: "plugin@m", scope: 7 }]));
    process.exit(0);
  }
  if (process.env.CLAUDE_LIST_INVALID) {
    process.stdout.write("not-json");
    process.exit(0);
  }
  const upgraded = readUpgraded();
  const entries = readInstalled().map((id) => ({
    id,
    version: upgraded.includes(id) ? "0.2.0" : "0.1.0",
    scope: "user",
    enabled: true,
    installPath: artifactPath(id),
  }));
  // Claude Code 2.1.287 also lists entries from other scopes: stale per-project
  // copies, claude.ai-synced plugins (one shadowed, with an empty installPath),
  // and a user-scope entry that failed to load.
  entries.push(
    { id: "datadog@synced", version: "0.7.17", scope: "synced", enabled: true, installPath: artifactPath("datadog@synced") },
    {
      id: "plugin@synced", version: "unknown", scope: "synced", enabled: true, installPath: "",
      notes: ["not loaded: shadowed"], noteDetails: [{ type: "synced-plugin-shadowed", related: "plugin@m" }],
    },
    { id: "plugin@m", version: "0.0.1", scope: "local", enabled: true, installPath: artifactPath("plugin@m"), projectPath: "/tmp/project" },
    { id: "skills@skills-dir", version: "unknown", scope: "user", enabled: false, installPath: "", errors: ["not loaded"], errorDetails: [{ type: "generic-error" }] },
  );
  process.stdout.write(JSON.stringify(entries));
  process.exit(0);
}

const id = args[2];
if (args[1] === "install") {
  if (marketplaceFile && !marketplaces.some((row) => row.name === id.split("@").pop())) process.exit(1);
  if (process.env.CLAUDE_FAIL_INSTALL === id) process.exit(1);
  const entries = readInstalled();
  if (entries.includes(id)) {
    console.log(`Plugin "${id}" is already installed (scope: user)`);
    process.exit(0);
  }
  entries.push(id);
  fs.mkdirSync(artifactPath(id), { recursive: true });
  writeInstalled(entries);
} else if (args[1] === "uninstall") {
  if (process.env.CLAUDE_FAIL_UNINSTALL === id) process.exit(1);
  writeInstalled(readInstalled().filter((entry) => entry !== id));
  fs.rmSync(artifactPath(id), { recursive: true, force: true });
} else if (args[1] === "update") {
  if (process.env.CLAUDE_FAIL_UPDATE === id) process.exit(1);
  fs.writeFileSync(upgradedFile, JSON.stringify([...readUpgraded(), id]));
}
