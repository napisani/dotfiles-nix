{% if vars.agent_profile == "work" %}{% set doppler = "loancrate" %}{% else %}{% set doppler = "personal" %}{% endif %}{
  "sources": {
    "doppler": {
      "env": "{{ doppler }}",
      "project": "workstation_env_vars",
      "credential": {"kind": "stored", "name": "{{ doppler }}-doppler"}
    }
  },
  "profiles": {
    "shell": {
      "exclude": [],
      "overwrite": true
    },
    "project-only": {
      "exclude": [],
      "remote_sources": false,
      "env_files": ["*.env", "*.env.local"]
    },
    "project": {
      "exclude": [],
      "remote_sources": true,
      "env_files": ["*.env", "*.env.local"]
    }
  },
  "storage": {
    "type": "keyring",
    "allowed_backends": ["darwin-age", "linux-systemd-credentials"]
  }
}
