{
  "sources": {
    "doppler": {
      "env": "personal",
      "project": "workstation_env_vars",
      "credential": {"kind": "stored", "name": "personal-doppler"}
    }
  },
  "profiles": {
    "shell": {
      "exclude": [],
      "overwrite": true
    },
    "project-only": {
      "exclude": [],
      "remote_sources": false,
      "env_files": ["*.env", "*.env.local"]
    },
    "project": {
      "exclude": [],
      "remote_sources": true,
      "env_files": ["*.env", "*.env.local"]
    }
  },
  "storage": {
    "type": "keyring",
    "allowed_backends": ["darwin-keychain", "linux-systemd-credentials"]
  }
}
