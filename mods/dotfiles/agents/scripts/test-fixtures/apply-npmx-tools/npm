#!/usr/bin/env node
const fs = require("node:fs");
const path = require("node:path");
const args = process.argv.slice(2);
fs.appendFileSync(process.env.CALL_LOG, args.join(" ") + "\n");
if (args[0] === "view") {
  const latest = JSON.parse(process.env.NPM_LATEST || "{}");
  if (process.env.NPM_FAIL_VIEW === args[1] || !latest[args[1]]) {
    process.exit(1);
  }
  console.log(JSON.stringify(latest[args[1]]));
  process.exit(0);
}
if (args[0] === "install") {
  const spec = args.at(-1);
  const at = spec.lastIndexOf("@");
  const name = spec.slice(0, at);
  const version = spec.slice(at + 1);
  if (process.env.NPM_FAIL_INSTALL === name) process.exit(1);
  const dir = path.join(
    process.env.NPM_CONFIG_PREFIX,
    "lib/node_modules",
    name,
  );
  const bin = path.join(
    process.env.NPM_CONFIG_PREFIX,
    "bin",
    name.split("/").pop(),
  );
  fs.mkdirSync(dir, { recursive: true });
  fs.mkdirSync(path.dirname(bin), { recursive: true });
  fs.writeFileSync(
    path.join(dir, "package.json"),
    JSON.stringify({ name, version, bin: "cli.js" }),
  );
  fs.writeFileSync(path.join(dir, "cli.js"), "fixture");
  fs.chmodSync(path.join(dir, "cli.js"), 0o755);
  fs.rmSync(bin, { force: true });
  fs.symlinkSync(path.join(dir, "cli.js"), bin);
} else if (args[0] === "uninstall") {
  const name = args.at(-1);
  if (process.env.NPM_FAIL_UNINSTALL === name) process.exit(1);
  fs.rmSync(
    path.join(process.env.NPM_CONFIG_PREFIX, "lib/node_modules", name),
    { recursive: true, force: true },
  );
  fs.rmSync(
    path.join(process.env.NPM_CONFIG_PREFIX, "bin", name.split("/").pop()),
    { force: true },
  );
} else {
  console.error("unexpected npm invocation");
  process.exit(2);
}
