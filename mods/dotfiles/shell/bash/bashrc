# Noninteractive SSH commands must not initialize terminal hooks.
case $- in
*i*) ;;
*) return ;;
esac

# Tests can select an unactivated checkout.
SHELL_DOTFILES_DIR="${SHELL_DOTFILES_DIR:-$HOME/.config/shell}"
export SHELL_DOTFILES_DIR

if [ ! -d "$SHELL_DOTFILES_DIR/bash/rc.d" ]; then
	printf 'bashrc: no fragments found at %s/bash/rc.d\n' "$SHELL_DOTFILES_DIR" >&2
	printf 'bashrc: run bootstrap.sh, or set SHELL_DOTFILES_DIR\n' >&2
	return
fi

# shellcheck disable=SC1091
. "$SHELL_DOTFILES_DIR/bash/lib/guards.sh"

# Hook dependencies require lexical order; see ../OWNERSHIP.md.
for _rc_fragment in "$SHELL_DOTFILES_DIR"/bash/rc.d/*.sh; do
	[ -r "$_rc_fragment" ] || continue
	# shellcheck disable=SC1090
	. "$_rc_fragment"
done
unset _rc_fragment
