# Login environment must be silent and safe without a terminal.
# Interactive hooks belong in bashrc; see ../OWNERSHIP.md.

# ── shared helpers ──────────────────────────────────────────────────────────
_shell_home="${SHELL_DOTFILES_DIR:-$HOME/.config/shell}"
if [ -r "$_shell_home/bash/lib/guards.sh" ]; then
	# shellcheck disable=SC1091
	. "$_shell_home/bash/lib/guards.sh"
else
	# Degrade to inline equivalents rather than failing to log in.
	sh_have() { command -v "$1" >/dev/null 2>&1; }
	sh_path_prepend() {
		[ -d "$1" ] || return 0
		case ":$PATH:" in *":$1:"*) return 0 ;; esac
		PATH="$1${PATH:+:$PATH}"
		export PATH
	}
	sh_path_append() {
		[ -d "$1" ] || return 0
		case ":$PATH:" in *":$1:"*) return 0 ;; esac
		PATH="${PATH:+$PATH:}$1"
		export PATH
	}
fi

# ── machine identity ────────────────────────────────────────────────────────
if [ -r "$_shell_home/bash/lib/machine.sh" ]; then
	# shellcheck disable=SC1091
	. "$_shell_home/bash/lib/machine.sh"
	MACHINE_NAME=$(sh_machine_name)
else
	MACHINE_NAME=$(hostname -s 2>/dev/null || echo unknown)
fi
export MACHINE_NAME

if [ -d "$HOME/.config/mise/dotfiles" ]; then
	DOTFILES_DIR=$(CDPATH='' cd -P -- "$HOME/.config/mise/dotfiles/../.." && pwd -P)
	export DOTFILES_DIR
fi

# ── homebrew ────────────────────────────────────────────────────────────────
# Must run before the sh_path_prepend calls below: `brew shellenv` prepends its own
# bin directories, so anything that has to outrank brew goes on afterwards.
if [ -z "${HOMEBREW_PREFIX:-}" ]; then
	for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
		if [ -x "$_brew" ]; then
			eval "$("$_brew" shellenv)"
			break
		fi
	done
	unset _brew
fi

# ── PATH ────────────────────────────────────────────────────────────────────
# Mise uses this cask prefix on Intel too, independently of Homebrew's prefix.
if [ "$(uname -s)" = Darwin ]; then
	sh_path_prepend /opt/homebrew/sbin
	sh_path_prepend /opt/homebrew/bin
fi
# macOS path_helper can put Apple Bash first in inherited login environments.
sh_path_prepend /run/current-system/sw/bin
# Editable tools and shell scripts take precedence over package-manager bins.
sh_path_prepend "$HOME/.local/bin"
# Mise shims must precede executables left in the legacy shared npm prefix.
sh_path_prepend "${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims"
# Child scripts need real tool paths to avoid a mise invocation per command.
# Keep shims as the bootstrap fallback when tools are not installed yet.
if sh_have mise; then
	if _mise_environment=$(mise env --shell bash); then
		eval "$_mise_environment"
	fi
	unset _mise_environment
fi
sh_path_prepend "$HOME/shell_scripts"
sh_path_prepend "$HOME/toolbox"

# Docker Desktop installs user commands here. Keep the path unique across
# nested login shells rather than appending it in both profile entry points.
sh_path_append "$HOME/.docker/bin"

# ── android ─────────────────────────────────────────────────────────────────
# Keyed off what is installed, not MACHINE_NAME: the SDK appears only after
# Android Studio's first-run setup, and the JDK only where zulu@17 is a cask.
if [ -d "$HOME/Library/Android/sdk" ]; then
	export ANDROID_HOME="$HOME/Library/Android/sdk"
	sh_path_append "$ANDROID_HOME/emulator"
	sh_path_append "$ANDROID_HOME/platform-tools"
fi
if [ -d /Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home ]; then
	export JAVA_HOME=/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home
fi

# ── editor ──────────────────────────────────────────────────────────────────
# macOS /etc/profile sets EDITOR=nano; an unset-only default would retain it.
if command -v nvim >/dev/null 2>&1; then
	EDITOR=nvim
elif [ -z "${EDITOR:-}" ]; then
	if command -v vim >/dev/null 2>&1; then
		EDITOR=vim
	else
		EDITOR=vi
	fi
fi
export EDITOR
export VISUAL="$EDITOR"

# ── shell identity ──────────────────────────────────────────────────────────
if [ -z "${SHELL:-}" ]; then
	SHELL=$(command -v bash 2>/dev/null || echo /bin/sh)
fi
export SHELL

# ── misc environment ────────────────────────────────────────────────────────
# File descriptor ceiling: watchers and bundlers on large repos exhaust the
# default 256 on macOS.
ulimit -n 65536 2>/dev/null || true

# Shell-local only; changing pnpm's inherited environment needs separate review.
PNPM_MANAGE_INSTALLATION=false

# ── local, untracked overrides ──────────────────────────────────────────────
if [ -r "$HOME/.profile.local" ]; then
	# shellcheck disable=SC1091
	. "$HOME/.profile.local"
fi
