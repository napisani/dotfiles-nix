# ~/.bash_profile — login shell entry point.
#
# Bash reads this (not ~/.bashrc) for login shells, so it has to pull in both:
# the environment from ~/.profile, then the interactive setup from ~/.bashrc.

# shellcheck disable=SC1091
[ -r "$HOME/.profile" ] && . "$HOME/.profile"

# shellcheck disable=SC1091
[ -r "$HOME/.bashrc" ] && . "$HOME/.bashrc"
