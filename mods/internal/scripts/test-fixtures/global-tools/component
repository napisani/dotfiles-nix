#!/usr/bin/env node
const fs = require('node:fs');
const log = process.env.CALL_LOG;
const previous = fs.existsSync(log) ? fs.readFileSync(log,'utf8').trim().split('\n').filter(Boolean) : [];
fs.appendFileSync(log, JSON.stringify({mode:process.env.RECONCILE_MODE, repair:process.env.GLOBAL_TOOLS_FORCE_REPAIR, update:process.env.GLOBAL_TOOLS_UPDATE})+'\n');
if (process.env.FAIL_FIRST_CALL && previous.length === 0) process.exit(1);
